TFL_APP_KEY=
TFL_API_BASE_URL=https://api.tfl.gov.uk/Line
TFL_MODES=tube,elizabeth-line,dlr,overground,tram
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tfl_intel
POSTGRES_USER=tfl_intel
POSTGRES_PASSWORD_FILE=secrets/postgres_password.txt
DUCKDB_PATH=/data/tfl_intel.duckdb
DBT_PROJECT_DIR=/workspace/dbt
MAX_PIPELINE_FRESHNESS_MINUTES=15
LOG_LEVEL=INFO
API_PORT=8000
API_BIND_ADDRESS=127.0.0.1
POSTGRES_BIND_ADDRESS=127.0.0.1
AIRFLOW_PORT=8080
AIRFLOW_BIND_ADDRESS=127.0.0.1
# Set this to the UID of the deployment account (id -u) before bootstrap.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
COMPOSE_PROJECT_NAME=tfl_intel
PROXY_NETWORK=npm_proxy
METABASE_PORT=3000
METABASE_BIND_ADDRESS=127.0.0.1
METABASE_SITE_URL=https://tfl-bi.victorjohnson.dev
PUBLISH_BI_MARTS=true
